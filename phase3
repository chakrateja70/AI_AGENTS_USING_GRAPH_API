# Tool execution functions
def execute_tool(tool_name: str, parameters: dict) -> str:
    try:
        if tool_name == "create_google_doc":
            return create_google_doc(parameters)
        elif tool_name == "update_google_doc":
            return update_google_doc(parameters)
        elif tool_name == "send_email":
            return send_email(parameters)
        else:
            return f"Unknown tool: {tool_name}"
    except Exception as e:
        return f"Error executing tool {tool_name}: {str(e)}"

def create_google_doc(params: dict) -> str:
