# Node 1: User Input
def user_input_node(state: ChatState) -> ChatState:
    messages = state.get("messages", [])
    user_text = state.get("user_input")
    messages.append({"role": "user", "content": user_text})
    return {**state, "messages": messages}

# Node 2: Agent Node with Tool Calling
def agent_node(state: ChatState) -> ChatState:
    messages = state.get("messages", [])
    conversation_text = "\n".join([f"{msg['role']}: {msg['content']}" for msg in messages])
   
    # Get LLM response with tool calling
    llm_response = openai_llm_with_tools(conversation_text, TOOL_DEFINITIONS)
   
    tool_requests = []
    tool_responses = []
   
    # Check if tool calls are present
    if llm_response.tool_calls:
        for tool_call in llm_response.tool_calls:
            tool_name = tool_call.function.name
            parameters = json.loads(tool_call.function.arguments)
           
            tool_requests.append({
                "tool_name": tool_name,
                "parameters": parameters
            })
           
            # Execute the tool
            result = execute_tool(tool_name, parameters)
            tool_responses.append({
                "tool_name": tool_name,
                "result": result
            })
           
            # Add tool response to messages
            messages.append({
                "role": "tool",
                "content": result,
                "tool_call_id": tool_call.id
            })
   
    # Add assistant response to messages
    if llm_response.content:
        messages.append({
            "role": "assistant",
            "content": llm_response.content
        })
   
    return {
        **state,
        "messages": messages,
        "result": llm_response.content,
        "tool_requests": tool_requests,
        "tool_responses": tool_responses
    }

# Graph setup
graph = StateGraph(ChatState)
graph.add_node("user", user_input_node)
graph.add_node("agent", agent_node)

graph.set_entry_point("user")
graph.add_edge("user", "agent")
graph.add_edge("agent", END)
app = graph.compile()

