# Chat state with tool execution capabilities
class ChatState(TypedDict, total=False):
    messages: List[dict]
    result: Optional[str]
    user_input: Optional[str]
    tool_requests: List[dict]
    tool_responses: List[dict]
    active_tools: Dict[str, Any]

# MCP Server Manager
class MCPServerManager:
    def __init__(self):
        self.servers = {}
       
    def start_server(self, tool_type: ToolType):
        if tool_type in self.servers:
            return self.servers[tool_type]
           
        config = MCP_SERVERS[tool_type]
        env = {**os.environ, **config["env"]}
       
        try:
            process = subprocess.Popen(
                [config["command"]] + config["args"],
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
           
            # Wait a bit for server to start
            time.sleep(2)
            self.servers[tool_type] = process
            return process
           
        except Exception as e:
            print(f"Failed to start {tool_type.value} server: {e}")
            return None

    def stop_all_servers(self):
        for process in self.servers.values():
            process.terminate()
        self.servers.clear()

# Initialize MCP server manager
mcp_manager = MCPServerManager()

# Enhanced LLM Model with tool calling
def openai_llm_with_tools(conversation_text: str, available_tools: List[dict]) -> dict:
    messages = [
        {
            "role": "system",
            "content": """You are a helpful assistant with access to various tools.
            You can create Google Docs, send emails, and perform other operations.
            When the user asks you to perform an action, use the appropriate tool.
            Always respond in a helpful manner and confirm when actions are completed."""
        },
        {
            "role": "user",
            "content": conversation_text
        }
    ]
   
    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=messages,
        tools=available_tools,
        tool_choice="auto"
    )
   
    return response.choices[0].message

